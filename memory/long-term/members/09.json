    {
      "message_id": "20261015-DOC-047",
      "source_date": "2026-10-15",
      "node": "UNSPECIFIED_IN_SOURCE",
      "kind": "message",
      "text": "这倒是。之前大家都在讨论AI能赚多少钱，现在开始关心它们欠了多少钱了。😂",
      "source_tab_id": "t.huff85y7dlym",
