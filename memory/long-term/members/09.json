    {
      "message_id": "20261015-DOC-053",
      "source_date": "2026-10-15",
      "node": "UNSPECIFIED_IN_SOURCE",
      "kind": "message",
      "text": "要是这么简单，每天等财报就行了。关键还得看之前的股价到底涨了多少。",
      "source_tab_id": "t.huff85y7dlym",
      "source_doc_revision": null,
